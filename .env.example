# ZENITH FLOW — variáveis de ambiente
# Copie os valores reais para apps/web/.env.local (app) e packages/db/.env (Prisma CLI) — nunca versionados.

# Postgres (Neon). DATABASE_URL é a conexão POOLED (host termina em
# "-pooler") — é o que a aplicação usa em toda query, evita o custo de um
# handshake novo a cada requisição. DIRECT_URL é a conexão direta (sem
# "-pooler"), usada só pelo Prisma Migrate/db push. Pegue as duas com
# `neon connection-string --project-id <id>` (uma com --pooled, outra sem).
DATABASE_URL=
DIRECT_URL=

# Better Auth — segredo de assinatura de sessão (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# URL pública onde o app roda (usada para cookies/callbacks).
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (armazenamento de arquivos — Arquivos do cliente e Biblioteca
# de conteúdo). Criar bucket + API token em dash.cloudflare.com > R2 Object
# Storage > Manage R2 API Tokens (permissão Object Read & Write, escopo só
# nesse bucket). Neon Object Storage não foi usado porque só está disponível
# em us-east-2/eu-central-1, e o projeto está em sa-east-1 (ver docs/DECISIONS.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
