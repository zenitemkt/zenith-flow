# ZENITH FLOW — variáveis de ambiente
# Copie os valores reais para apps/web/.env.local (app) e packages/db/.env (Prisma CLI) — nunca versionados.

# Postgres (Neon). Obtida com `neon connection-string --project-id <id>`.
DATABASE_URL=

# Better Auth — segredo de assinatura de sessão (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# URL pública onde o app roda (usada para cookies/callbacks).
BETTER_AUTH_URL=http://localhost:3000
