generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core schema — nomes e formato exigidos pelo adapter)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  squadMemberships SquadMember[]
  employee         Employee?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  /// Chave de linkagem segura entre provedores (ex.: "local:credential"),
  /// exigida pelo Better Auth >=1.3 — não documentada no gerador de schema
  /// oficial, que está descontinuado (ver docs/DECISIONS.md).
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domínio ZENITH FLOW — Agência, workspace, membros e RBAC (seção 7 do manual)
// ---------------------------------------------------------------------------

enum WorkspaceKind {
  AGENCY
  CLIENT
}

enum MembershipRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  MANAGER
  ANALYST
  FINANCE
  HR
  CLIENT_ADMIN
  CLIENT_VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces          Workspace[]
  memberships         Membership[]
  auditLogs           AuditLog[]
  clients             Client[]
  onboardingTemplates OnboardingTemplate[]
  requests            Request[]
  projects            Project[]
  routineTemplates    RoutineTemplate[]
  squads              Squad[]
  vendors             Vendor[]
  contentItems        ContentItem[]
  commentThreads      CommentThread[]
  employees           Employee[]
  leaveRequests       LeaveRequest[]
  timesheets          Timesheet[]
  timeEntries         TimeEntry[]

  @@map("agency")
}

model Workspace {
  id        String        @id @default(cuid())
  agencyId  String
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  kind      WorkspaceKind @default(CLIENT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships Membership[]
  client      Client?

  @@index([agencyId])
  @@map("workspace")
}

/// Vínculo usuário-agência/workspace-papel (seção 7 do manual). Toda membership
/// aponta para um workspace específico — inclusive o workspace interno (kind
/// AGENCY) criado junto com a agência, que representa a própria equipe.
model Membership {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  agencyId        String
  agency          Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role            MembershipRole
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?
  inviteToken     String?          @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([workspaceId, email])
  @@index([userId])
  @@index([agencyId])
  @@map("membership")
}

/// Append-only. Nunca editar ou apagar uma linha existente (seção 48.1 do manual).
model AuditLog {
  id           String   @id @default(cuid())
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorType    String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([agencyId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Clientes e onboarding — Release 1B (seções 10 e 11 do manual)
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ONBOARDING
  ATIVO
  PAUSADO
  EM_ENCERRAMENTO
  ENCERRADO
  REATIVADO
}

model Client {
  id          String       @id @default(cuid())
  agencyId    String
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  /// Criado somente na ativação (seção 10: "ao ativar: ... criar portal").
  /// Antes disso o cliente não tem escopo de acesso próprio.
  workspaceId String?      @unique
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name        String
  document    String?
  email       String?
  phone       String?
  whatsapp    String?
  status      ClientStatus @default(PROSPECT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contacts         ClientContact[]
  statusHistory    ClientStatusHistory[]
  notes            ClientNote[]
  onboardingRuns   OnboardingRun[]
  requests         Request[]
  projects         Project[]
  routineTemplates RoutineTemplate[]
  allocations      ClientAllocation[]
  contentItems     ContentItem[]

  @@index([agencyId])
  @@map("client")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  /// Finalidade do contato (ex.: "Geral", "Financeiro", "Aprovação").
  role      String   @default("Geral")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_contact")
}

/// Append-only — mudança crítica de status sempre exige motivo (seção 10).
model ClientStatusHistory {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStatus  ClientStatus?
  toStatus    ClientStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime      @default(now())

  @@index([clientId])
  @@map("client_status_history")
}

model ClientNote {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@map("client_note")
}

model OnboardingTemplate {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  items OnboardingTemplateItem[]
  runs  OnboardingRun[]

  @@index([agencyId])
  @@map("onboarding_template")
}

model OnboardingTemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int

  @@index([templateId])
  @@map("onboarding_template_item")
}

enum OnboardingRunStatus {
  EM_ANDAMENTO
  BLOQUEADO
  PRONTO
  CONCLUIDO
  CANCELADO
}

model OnboardingRun {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId  String?
  template    OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      OnboardingRunStatus @default(EM_ANDAMENTO)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  items OnboardingItem[]

  @@index([clientId])
  @@map("onboarding_run")
}

enum OnboardingItemStatus {
  PENDENTE
  BLOQUEADO
  CONCLUIDO
}

/// Dependência entre itens é sequencial por `order` (decisão pragmática do
/// MVP — não é um grafo arbitrário de dependências). Ver docs/DECISIONS.md.
model OnboardingItem {
  id                String               @id @default(cuid())
  runId             String
  run               OnboardingRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  order             Int
  status            OnboardingItemStatus @default(PENDENTE)
  completedAt       DateTime?
  completedByUserId String?

  @@index([runId])
  @@map("onboarding_item")
}

// ---------------------------------------------------------------------------
// Demandas — Release 1C, parte 1 (seção 13 do manual)
// ---------------------------------------------------------------------------

enum RequestStatus {
  NOVA
  TRIAGEM
  AGUARDANDO_INFORMACAO
  APROVADA
  REJEITADA
  CONVERTIDA
  CONCLUIDA
}

enum RequestPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// "Convertida" cria uma Task real via POST /api/requests/:id/convert
/// (endpoint dedicado, não a rota genérica de status — precisa saber em qual
/// projeto a tarefa entra). convertedTaskId guarda o resultado da conversão.
model Request {
  id                String           @id @default(cuid())
  agencyId          String
  agency            Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  status            RequestStatus    @default(NOVA)
  priority          RequestPriority?
  /// Nome de quem pediu — pessoa da agência ou contato do cliente; ainda não
  /// há portal do cliente (Fase 1D), então hoje é sempre preenchido manualmente.
  requesterName     String?
  requestedByUserId String?
  rejectionReason   String?
  convertedTaskId   String?          @unique
  convertedTask     Task?            @relation(fields: [convertedTaskId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  statusHistory RequestStatusHistory[]

  @@index([agencyId])
  @@index([clientId])
  @@map("request")
}

/// Append-only, mesmo padrão de ClientStatusHistory.
model RequestStatusHistory {
  id          String         @id @default(cuid())
  requestId   String
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime       @default(now())

  @@index([requestId])
  @@map("request_status_history")
}

// ---------------------------------------------------------------------------
// Projetos e tarefas — Release 1C, parte 2 (seção 14 do manual)
// ---------------------------------------------------------------------------

/// Estado único compartilhado por Project e Task (o manual descreve uma única
/// cadeia — seção 14 — sem diferenciar as duas entidades).
enum WorkItemStatus {
  BACKLOG
  PLANEJADA
  EM_ANDAMENTO
  BLOQUEADA
  REVISAO
  CONCLUIDA
  CANCELADA
}

/// Projeto pertence a cliente ou à agência (seção 14: "projeto pertence a
/// cliente ou a agência") — clientId nulo = projeto interno.
model Project {
  id        String         @id @default(cuid())
  agencyId  String
  agency    Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name      String
  status    WorkItemStatus @default(BACKLOG)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tasks       Task[]
  routineRuns RoutineRun[]

  @@index([agencyId])
  @@index([clientId])
  @@map("project")
}

/// Dependência simplificada como bloqueio único (`blockedByTaskId`), mesmo
/// espírito pragmático do checklist de onboarding — não é um grafo arbitrário.
model Task {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           WorkItemStatus @default(BACKLOG)
  blockedByTaskId  String?
  blockedBy        Task?          @relation("TaskBlocks", fields: [blockedByTaskId], references: [id], onDelete: SetNull)
  blocks           Task[]         @relation("TaskBlocks")
  assigneeUserId   String?
  /// Seção 21 do manual — usado pra comparar estimado x realizado com o
  /// somatório de TimeEntry.minutes. Opcional: nem toda tarefa tem estimativa.
  estimatedMinutes Int?
  dueDate          DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  statusHistory TaskStatusHistory[]
  sourceRequest Request?
  vendorOrders  VendorOrder[]
  timeEntries   TimeEntry[]

  @@index([projectId])
  @@map("task")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model TaskStatusHistory {
  id          String          @id @default(cuid())
  taskId      String
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus  WorkItemStatus?
  toStatus    WorkItemStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime        @default(now())

  @@index([taskId])
  @@map("task_status_history")
}

// ---------------------------------------------------------------------------
// Rotinas recorrentes — Release 1C, parte 3 (seção 15 do manual)
// ---------------------------------------------------------------------------

enum RoutineStatus {
  RASCUNHO
  ATIVO
  PAUSADO
  ARQUIVADO
}

enum RoutineRunStatus {
  AGENDADA
  CRIADA
  IGNORADA
  FALHOU
}

/// Só recorrência mensal (dia fixo do mês) nesta fatia — semanal/dias úteis
/// ficam para quando houver caso real pedindo. Ver docs/DECISIONS.md.
model RoutineTemplate {
  id         String        @id @default(cuid())
  agencyId   String
  agency     Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name       String
  status     RoutineStatus @default(RASCUNHO)
  /// Dia do mês em que a rotina deve gerar (1-28, evita problema com meses curtos).
  dayOfMonth Int           @default(1)
  timezone   String        @default("America/Sao_Paulo")
  startDate  DateTime      @default(now())
  endDate    DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tasks RoutineTemplateTask[]
  runs  RoutineRun[]

  @@index([agencyId])
  @@index([clientId])
  @@map("routine_template")
}

model RoutineTemplateTask {
  id          String          @id @default(cuid())
  templateId  String
  template    RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int

  @@index([templateId])
  @@map("routine_template_task")
}

/// `@@unique([templateId, period])` É a chave de idempotência (seção 15:
/// "idempotency key impede duplicidade por rotina+período") — não é só
/// uma otimização, é a garantia contra rodar a mesma rotina duas vezes.
model RoutineRun {
  id           String           @id @default(cuid())
  templateId   String
  template     RoutineTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Rótulo do período, ex.: "2026-09" para rotina mensal.
  period       String
  status       RoutineRunStatus @default(AGENDADA)
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  errorMessage String?
  createdAt    DateTime         @default(now())

  @@unique([templateId, period])
  @@index([templateId])
  @@map("routine_run")
}

// ---------------------------------------------------------------------------
// Squads e capacidade — Release 1C, parte 4 (seção 16 do manual)
// ---------------------------------------------------------------------------

enum AllocationStatus {
  ATIVA
  ENCERRADA
}

model Squad {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     SquadMember[]
  allocations ClientAllocation[]

  @@index([agencyId])
  @@map("squad")
}

model SquadMember {
  id       String   @id @default(cuid())
  squadId  String
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([squadId, userId])
  @@map("squad_member")
}

/// Histórico de squad responsável por cliente — reatribuir encerra a linha
/// anterior (status ENCERRADA + endDate) e cria uma nova, nunca apaga
/// ("troca de responsável registra handoff", seção 16 do manual). Só squad
/// principal nesta fatia — especialistas individuais ficam para depois.
model ClientAllocation {
  id        String           @id @default(cuid())
  clientId  String
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  squadId   String
  squad     Squad            @relation(fields: [squadId], references: [id], onDelete: Cascade)
  status    AllocationStatus @default(ATIVA)
  startDate DateTime         @default(now())
  endDate   DateTime?
  createdAt DateTime         @default(now())

  @@index([clientId])
  @@index([squadId])
  @@map("client_allocation")
}

// ---------------------------------------------------------------------------
// Fornecedores — Release 1C, parte 5 (seção 16 do manual)
// ---------------------------------------------------------------------------

enum VendorStatus {
  HOMOLOGADO
  BLOQUEADO
}

enum VendorOrderStatus {
  SOLICITADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Vendor {
  id           String       @id @default(cuid())
  agencyId     String
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  contactEmail String?
  contactPhone String?
  status       VendorStatus @default(HOMOLOGADO)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders VendorOrder[]

  @@index([agencyId])
  @@map("vendor")
}

/// "Tarefa externa gera ordem ao fornecedor" (seção 16) — taskId é opcional
/// porque nem toda ordem nasce de uma tarefa interna já criada.
model VendorOrder {
  id          String            @id @default(cuid())
  vendorId    String
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  description String
  status      VendorOrderStatus @default(SOLICITADA)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([vendorId])
  @@map("vendor_order")
}

// ---------------------------------------------------------------------------
// Conteúdo e calendário editorial — Release 1D, parte 1 (seção 17 do manual)
// ---------------------------------------------------------------------------

enum ContentStatus {
  IDEIA
  PAUTA
  PRODUCAO
  REVISAO_INTERNA
  AGUARDANDO_CLIENTE
  AJUSTES
  APROVADO
  AGENDADO
  PUBLICADO
  ARQUIVADO
}

enum ContentChannel {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  OUTRO
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  AJUSTES_SOLICITADOS
}

model ContentItem {
  id            String         @id @default(cuid())
  agencyId      String
  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  channel       ContentChannel
  format        String?
  campaign      String?
  caption       String?
  scheduledDate DateTime?
  status        ContentStatus  @default(IDEIA)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  versions      ContentVersion[]
  statusHistory ContentStatusHistory[]

  @@index([agencyId])
  @@index([clientId])
  @@map("content_item")
}

/// Cada envio de material cria uma versão nova; a aprovação vale só para
/// aquela versão específica (seção 17: "cada upload cria versão; aprovação
/// vale para uma versão específica"). `assetUrl` é um link externo (Drive,
/// Figma, Canva...) — sem upload de arquivo nesta fatia (ver docs/DECISIONS.md).
model ContentVersion {
  id              String      @id @default(cuid())
  contentItemId   String
  contentItem     ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  versionNumber   Int
  assetUrl        String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime    @default(now())

  approval ContentApproval?

  @@unique([contentItemId, versionNumber])
  @@map("content_version")
}

/// Token público de aprovação (mesmo padrão do convite de membro): sem
/// login, expira, e o cliente só vê o que essa versão específica expõe —
/// "links públicos usam token curto, expiração... escopo mínimo" (seção 18).
model ContentApproval {
  id               String         @id @default(cuid())
  contentVersionId String         @unique
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  token            String         @unique
  status           ApprovalStatus @default(PENDENTE)
  decisionNote     String?
  decidedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())

  @@map("content_approval")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model ContentStatusHistory {
  id            String         @id @default(cuid())
  contentItemId String
  contentItem   ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  fromStatus    ContentStatus?
  toStatus      ContentStatus
  reason        String?
  actorUserId   String?
  createdAt     DateTime       @default(now())

  @@index([contentItemId])
  @@map("content_status_history")
}

// ---------------------------------------------------------------------------
// Comunicação e comentários — Release 1D (seção 19 do manual)
// ---------------------------------------------------------------------------

enum CommentThreadStatus {
  ABERTA
  RESOLVIDA
}

enum CommentStatus {
  ATIVO
  EDITADO
  REMOVIDO
}

/// Uma thread por entidade (entityType+entityId) — seção 19: "comentário
/// pertence a uma entidade e workspace". Criada sob demanda no primeiro
/// comentário; entityType é texto livre ("content_item", "request" etc.),
/// não uma FK — a mesma tabela serve qualquer entidade comentável sem
/// precisar de uma coluna nova por módulo.
model CommentThread {
  id               String              @id @default(cuid())
  agencyId         String
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  entityType       String
  entityId         String
  status           CommentThreadStatus @default(ABERTA)
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime            @default(now())

  comments Comment[]

  @@unique([entityType, entityId])
  @@index([agencyId])
  @@map("comment_thread")
}

model Comment {
  id           String        @id @default(cuid())
  threadId     String
  thread       CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  status       CommentStatus @default(ATIVO)
  editedAt     DateTime?
  createdAt    DateTime      @default(now())

  edits    CommentEdit[]
  mentions CommentMention[]

  @@index([threadId])
  @@map("comment")
}

/// Append-only — "edição mantém histórico; exclusão sensível vira tombstone"
/// (seção 19): cada edição E cada remoção gravam o texto anterior aqui antes
/// de mudar o Comment; remover não apaga a linha, só limpa o body e marca
/// status REMOVIDO, deixando um tombstone visível no lugar.
model CommentEdit {
  id             String   @id @default(cuid())
  commentId      String
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  previousBody   String
  editedByUserId String
  createdAt      DateTime @default(now())

  @@index([commentId])
  @@map("comment_edit")
}

model CommentMention {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  createdAt       DateTime @default(now())

  @@index([commentId])
  @@index([mentionedUserId])
  @@map("comment_mention")
}

// ---------------------------------------------------------------------------
// RH e pessoas — Release 1E, parte 1 (seção 20 do manual)
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ATIVO
  AFASTADO
  DESLIGADO
}

/// Dado de contratação — separado de Membership (acesso/login) de propósito,
/// ver docs/DECISIONS.md ("Convite de equipe mora em Configurações, não em
/// Pessoas"). userId é opcional: nem toda pessoa cadastrada em RH tem conta
/// no sistema (ex.: freelancer sem login).
model Employee {
  id           String         @id @default(cuid())
  agencyId     String
  agency       Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String?
  role         String?
  status       EmployeeStatus @default(ATIVO)
  hiredAt      DateTime?
  terminatedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  leaveRequests LeaveRequest[]
  statusHistory EmployeeStatusHistory[]

  @@index([agencyId])
  @@map("employee")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model EmployeeStatusHistory {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromStatus  EmployeeStatus?
  toStatus    EmployeeStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime        @default(now())

  @@index([employeeId])
  @@map("employee_status_history")
}

enum LeaveType {
  FERIAS
  AUSENCIA
}

enum LeaveRequestStatus {
  SOLICITADA
  APROVADA
  REJEITADA
  REALIZADA
}

model LeaveRequest {
  id                String             @id @default(cuid())
  agencyId          String
  agency            Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type              LeaveType
  startDate         DateTime
  endDate           DateTime
  status            LeaveRequestStatus @default(SOLICITADA)
  reason            String?
  rejectionReason   String?
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  statusHistory LeaveRequestStatusHistory[]

  @@index([agencyId])
  @@index([employeeId])
  @@map("leave_request")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model LeaveRequestStatusHistory {
  id             String              @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest        @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  fromStatus     LeaveRequestStatus?
  toStatus       LeaveRequestStatus
  reason         String?
  actorUserId    String?
  createdAt      DateTime            @default(now())

  @@index([leaveRequestId])
  @@map("leave_request_status_history")
}

// ---------------------------------------------------------------------------
// Apontamento e produtividade — Release 1E, parte 2 (seção 21 do manual)
// ---------------------------------------------------------------------------

enum TimesheetStatus {
  RASCUNHO
  ENVIADA
  APROVADA
  CORRIGIDA
}

/// Folha semanal — container de TimeEntry por pessoa+semana. Criada sob
/// demanda (mesmo padrão de CommentThread) no primeiro apontamento da semana.
model Timesheet {
  id               String          @id @default(cuid())
  agencyId         String
  agency           Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId           String
  /// Segunda-feira da semana que esta folha cobre.
  weekStart        DateTime
  status           TimesheetStatus @default(RASCUNHO)
  submittedAt      DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  entries       TimeEntry[]
  statusHistory TimesheetStatusHistory[]

  @@unique([userId, weekStart])
  @@index([agencyId])
  @@map("timesheet")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model TimesheetStatusHistory {
  id          String           @id @default(cuid())
  timesheetId String
  timesheet   Timesheet        @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  fromStatus  TimesheetStatus?
  toStatus    TimesheetStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime         @default(now())

  @@index([timesheetId])
  @@map("timesheet_status_history")
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

model TimeEntry {
  id          String          @id @default(cuid())
  agencyId    String
  agency      Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId      String
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timesheetId String
  timesheet   Timesheet       @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime
  minutes     Int
  description String?
  source      TimeEntrySource @default(MANUAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  edits TimeEntryEdit[]

  @@index([agencyId])
  @@index([userId])
  @@index([taskId])
  @@index([timesheetId])
  @@map("time_entry")
}

/// Append-only — "correção posterior guarda autor e motivo" (seção 21).
model TimeEntryEdit {
  id              String    @id @default(cuid())
  timeEntryId     String
  timeEntry       TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  previousMinutes Int
  reason          String?
  editedByUserId  String
  createdAt       DateTime  @default(now())

  @@index([timeEntryId])
  @@map("time_entry_edit")
}
