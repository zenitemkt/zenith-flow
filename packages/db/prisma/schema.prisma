generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core schema — nomes e formato exigidos pelo adapter)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  employee    Employee?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  /// Chave de linkagem segura entre provedores (ex.: "local:credential"),
  /// exigida pelo Better Auth >=1.3 — não documentada no gerador de schema
  /// oficial, que está descontinuado (ver docs/DECISIONS.md).
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domínio ZENITH FLOW — Agência, workspace, membros e RBAC (seção 7 do manual)
// ---------------------------------------------------------------------------

enum WorkspaceKind {
  AGENCY
  CLIENT
}

enum MembershipRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  MANAGER
  ANALYST
  FINANCE
  HR
  CLIENT_ADMIN
  CLIENT_VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces             Workspace[]
  memberships            Membership[]
  auditLogs              AuditLog[]
  clients                Client[]
  onboardingTemplates    OnboardingTemplate[]
  projects               Project[]
  recurringTaskTemplates RecurringTaskTemplate[]
  vendors                Vendor[]
  contentItems           ContentItem[]
  commentThreads         CommentThread[]
  employees              Employee[]
  positions              Position[]
  jobs                   Job[]
  candidates             Candidate[]
  leaveRequests          LeaveRequest[]
  timesheets             Timesheet[]
  timeEntries            TimeEntry[]
  financeCategories      FinanceCategory[]
  financeEntries         FinanceEntry[]
  mediaAssets            MediaAsset[]
  healthScoreSnapshots   HealthScoreSnapshot[]
  churnRiskSnapshots     ChurnRiskSnapshot[]
  retentionPlans         RetentionPlan[]
  surveyCampaigns        SurveyCampaign[]
  npsSnapshots           NpsSnapshot[]
  enpsCampaigns          EnpsCampaign[]
  enpsSnapshots          EnpsSnapshot[]
  leads                  Lead[]
  pipelineStages         PipelineStage[]
  opportunities          Opportunity[]
  proposals              Proposal[]
  /// Chave pública (não-secreta) do coletor de tracking — ver seção "Tracking"
  /// abaixo. Gerada sob demanda na primeira visita a `/integracoes`.
  trackingWriteKey       String?                 @unique
  trackingVisitors       TrackingVisitor[]
  trackingEvents         TrackingEvent[]
  trackingConsents       TrackingConsent[]
  campaigns              Campaign[]
  workflows              Workflow[]
  operationStages        OperationStage[]

  @@map("agency")
}

model Workspace {
  id        String        @id @default(cuid())
  agencyId  String
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  kind      WorkspaceKind @default(CLIENT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships Membership[]
  client      Client?

  @@index([agencyId])
  @@map("workspace")
}

/// Vínculo usuário-agência/workspace-papel (seção 7 do manual). Toda membership
/// aponta para um workspace específico — inclusive o workspace interno (kind
/// AGENCY) criado junto com a agência, que representa a própria equipe.
model Membership {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  agencyId        String
  agency          Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role            MembershipRole
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?
  inviteToken     String?          @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([workspaceId, email])
  @@index([userId])
  @@index([agencyId])
  @@map("membership")
}

/// Append-only. Nunca editar ou apagar uma linha existente (seção 48.1 do manual).
model AuditLog {
  id           String   @id @default(cuid())
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorType    String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([agencyId])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Clientes e onboarding — Release 1B (seções 10 e 11 do manual)
// ---------------------------------------------------------------------------

enum ClientStatus {
  PROSPECT
  ONBOARDING
  ATIVO
  PAUSADO
  EM_ENCERRAMENTO
  ENCERRADO
  REATIVADO
}

model Client {
  id                   String       @id @default(cuid())
  agencyId             String
  agency               Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  /// Criado somente na ativação (seção 10: "ao ativar: ... criar portal").
  /// Antes disso o cliente não tem escopo de acesso próprio.
  workspaceId          String?      @unique
  workspace            Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name                 String
  document             String?
  email                String?
  phone                String?
  whatsapp             String?
  status               ClientStatus @default(PROSPECT)
  /// Seção 32.3: "clientes encerrados mantêm motivo [já em ClientStatusHistory.reason],
  /// concorrente quando informado... elegibilidade." MRR perdido fica de fora —
  /// não há modelo de receita recorrente ainda (mesmo bloqueio da seção 29).
  competitorName       String?
  reactivationEligible Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  contacts               ClientContact[]
  statusHistory          ClientStatusHistory[]
  notes                  ClientNote[]
  onboardingRuns         OnboardingRun[]
  projects               Project[]
  recurringTaskTemplates RecurringTaskTemplate[]
  contentItems           ContentItem[]
  financeEntries         FinanceEntry[]
  mediaAssets            MediaAsset[]
  healthScoreSnapshots   HealthScoreSnapshot[]
  churnRiskSnapshots     ChurnRiskSnapshot[]
  retentionPlans         RetentionPlan[]
  surveyRecipients       SurveyRecipient[]
  convertedFromLead      Lead?
  opportunities          Opportunity[]
  proposals              Proposal[]
  campaigns              Campaign[]

  @@index([agencyId])
  @@map("client")
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  /// Finalidade do contato (ex.: "Geral", "Financeiro", "Aprovação").
  role            String   @default("Geral")
  isPrimary       Boolean  @default(false)
  /// Seção 32: "contatos com opt-out não recebem marketing" — inclui
  /// pesquisas de NPS. Nunca selecionável como destinatário enquanto true.
  marketingOptOut Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([clientId])
  @@map("client_contact")
}

/// Append-only — mudança crítica de status sempre exige motivo (seção 10).
model ClientStatusHistory {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStatus  ClientStatus?
  toStatus    ClientStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime      @default(now())

  @@index([clientId])
  @@map("client_status_history")
}

model ClientNote {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@map("client_note")
}

model OnboardingTemplate {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  items OnboardingTemplateItem[]
  runs  OnboardingRun[]

  @@index([agencyId])
  @@map("onboarding_template")
}

model OnboardingTemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int

  @@index([templateId])
  @@map("onboarding_template_item")
}

enum OnboardingRunStatus {
  EM_ANDAMENTO
  BLOQUEADO
  PRONTO
  CONCLUIDO
  CANCELADO
}

model OnboardingRun {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId  String?
  template    OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      OnboardingRunStatus @default(EM_ANDAMENTO)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  items OnboardingItem[]

  @@index([clientId])
  @@map("onboarding_run")
}

enum OnboardingItemStatus {
  PENDENTE
  BLOQUEADO
  CONCLUIDO
}

/// Dependência entre itens é sequencial por `order` (decisão pragmática do
/// MVP — não é um grafo arbitrário de dependências). Ver docs/DECISIONS.md.
model OnboardingItem {
  id                String               @id @default(cuid())
  runId             String
  run               OnboardingRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  order             Int
  status            OnboardingItemStatus @default(PENDENTE)
  completedAt       DateTime?
  completedByUserId String?

  @@index([runId])
  @@map("onboarding_item")
}

// ---------------------------------------------------------------------------
// Kanban unificado de Operação — substitui Projetos/Tarefas/Demandas/
// Rotinas/Squads (2026-09-06, ver docs/DECISIONS.md). Board de 3 lanes
// (A Fazer/Fazendo/Concluído) por pessoa + fila sequencial de responsáveis +
// checklist opcional + recorrência (mensal ou datas específicas).
// ---------------------------------------------------------------------------

/// Estado único compartilhado por Project e Task. O board novo só expõe
/// BACKLOG ("A Fazer"), EM_ANDAMENTO ("Fazendo") e CONCLUIDA ("Concluído")
/// como colunas, e CANCELADA como ação — mas o enum inteiro é preservado
/// porque Health Score e Risco de Churn dependem dos valores específicos
/// (nenhuma migração de dado necessária).
enum WorkItemStatus {
  BACKLOG
  PLANEJADA
  EM_ANDAMENTO
  BLOQUEADA
  REVISAO
  CONCLUIDA
  CANCELADA
}

/// Projeto vira 100% interno/invisível — sem página, sem nav — a partir do
/// Kanban unificado: cada tarefa é anexada automaticamente a um projeto
/// "guarda-chuva" por cliente (findFirst-ou-create, mesmo padrão já usado no
/// projeto "Cobrança" da régua de cobrança), preservando FinanceEntry/
/// VendorOrder/Timesheets sem precisar mudar nada nelas. Ver docs/DECISIONS.md.
model Project {
  id        String         @id @default(cuid())
  agencyId  String
  agency    Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name      String
  status    WorkItemStatus @default(BACKLOG)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tasks          Task[]
  financeEntries FinanceEntry[]

  @@index([agencyId])
  @@index([clientId])
  @@map("project")
}

/// Dependência simplificada como bloqueio único (`blockedByTaskId`) — não é
/// um grafo arbitrário. `assigneeUserId` é sempre "quem está na vez agora"
/// (cache denormalizado mantido em sincronia pela fila `TaskAssignee`).
model Task {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           WorkItemStatus  @default(BACKLOG)
  blockedByTaskId  String?
  blockedBy        Task?           @relation("TaskBlocks", fields: [blockedByTaskId], references: [id], onDelete: SetNull)
  blocks           Task[]          @relation("TaskBlocks")
  assigneeUserId   String?
  /// Só preenchido enquanto `status = EM_ANDAMENTO` — coluna customizável
  /// dentro do balde "Fazendo" (ver `OperationStage`). Nunca decide sozinho
  /// se a tarefa está concluída; isso é sempre `status`.
  stageId          String?
  stage            OperationStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  /// Usado pra comparar estimado x realizado com o somatório de
  /// TimeEntry.minutes. Opcional: nem toda tarefa tem estimativa.
  estimatedMinutes Int?
  dueDate          DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  statusHistory       TaskStatusHistory[]
  assignees           TaskAssignee[]
  checklistItems      TaskChecklistItem[]
  sourceComment       Comment?
  vendorOrders        VendorOrder[]
  timeEntries         TimeEntry[]
  collectionFor       FinanceEntry?
  recurringGeneration RecurringTaskGeneration?

  @@index([projectId])
  @@map("task")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model TaskStatusHistory {
  id          String          @id @default(cuid())
  taskId      String
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus  WorkItemStatus?
  toStatus    WorkItemStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime        @default(now())

  @@index([taskId])
  @@map("task_status_history")
}

/// Fila sequencial de responsáveis: a tarefa só aparece na coluna "A Fazer"
/// de quem está na vez (`Task.assigneeUserId`). Concluir a parte de alguém
/// marca `completedAt` aqui e promove o próximo `order` — se não há próximo,
/// a Task inteira vai pra CONCLUIDA. `@@unique([taskId, order])` garante que
/// a fila nunca tem posição duplicada.
model TaskAssignee {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  order       Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([taskId, order])
  @@index([taskId])
  @@map("task_assignee")
}

/// Checklist opcional por tarefa — puramente informativo, não bloqueia
/// conclusão (mesmo espírito de OnboardingItem/RoutineTemplateTask).
model TaskChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  done        Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([taskId])
  @@map("task_checklist_item")
}

enum RecurrenceMode {
  MENSAL
  DATAS_ESPECIFICAS
}

enum RecurringTaskStatus {
  RASCUNHO
  ATIVO
  PAUSADO
}

/// Substitui RoutineTemplate: gera uma Tarefa por período (não um Projeto+N
/// tarefas como antes) — mesmo padrão de fila/checklist do template é
/// copiado pra cada geração. Geração continua manual ("Gerar agora"), mesmo
/// padrão de tudo que dependeria de apps/worker (ainda não existe).
model RecurringTaskTemplate {
  id               String              @id @default(cuid())
  agencyId         String
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  estimatedMinutes Int?
  recurrenceMode   RecurrenceMode
  /// Usado só quando recurrenceMode = MENSAL (1-28, evita problema com meses curtos).
  dayOfMonth       Int?
  status           RecurringTaskStatus @default(RASCUNHO)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  assignees      RecurringTaskAssignee[]
  checklistItems RecurringTaskChecklistItem[]
  dates          RecurringTaskDate[]
  generations    RecurringTaskGeneration[]

  @@index([agencyId])
  @@index([clientId])
  @@map("recurring_task_template")
}

/// Fila de responsáveis do template — copiada (como TaskAssignee) pra cada
/// tarefa gerada.
model RecurringTaskAssignee {
  id         String                @id @default(cuid())
  templateId String
  template   RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  order      Int

  @@unique([templateId, order])
  @@index([templateId])
  @@map("recurring_task_assignee")
}

/// Checklist do template — copiado (como TaskChecklistItem) pra cada tarefa gerada.
model RecurringTaskChecklistItem {
  id         String                @id @default(cuid())
  templateId String
  template   RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  order      Int

  @@index([templateId])
  @@map("recurring_task_checklist_item")
}

/// Só usado quando recurrenceMode = DATAS_ESPECIFICAS — datas escolhidas à
/// mão num calendário multi-seleção na criação do template.
model RecurringTaskDate {
  id         String                @id @default(cuid())
  templateId String
  template   RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  date       DateTime

  @@unique([templateId, date])
  @@index([templateId])
  @@map("recurring_task_date")
}

/// `@@unique([templateId, period])` é a mesma garantia de idempotência real
/// do banco que RoutineRun já tinha (seção 15 do manual) — não é só uma
/// checagem de aplicação. `period` é "AAAA-MM" no modo mensal, ou a data ISO
/// da ocorrência no modo datas específicas.
model RecurringTaskGeneration {
  id         String                @id @default(cuid())
  templateId String
  template   RecurringTaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  period     String
  taskId     String?               @unique
  task       Task?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())

  @@unique([templateId, period])
  @@index([templateId])
  @@map("recurring_task_generation")
}

// ---------------------------------------------------------------------------
// Fornecedores — Release 1C, parte 5 (seção 16 do manual)
// ---------------------------------------------------------------------------

enum VendorStatus {
  HOMOLOGADO
  BLOQUEADO
}

enum VendorOrderStatus {
  SOLICITADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Vendor {
  id           String       @id @default(cuid())
  agencyId     String
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  contactEmail String?
  contactPhone String?
  status       VendorStatus @default(HOMOLOGADO)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders VendorOrder[]

  @@index([agencyId])
  @@map("vendor")
}

/// "Tarefa externa gera ordem ao fornecedor" (seção 16) — taskId é opcional
/// porque nem toda ordem nasce de uma tarefa interna já criada.
model VendorOrder {
  id          String            @id @default(cuid())
  vendorId    String
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  description String
  status      VendorOrderStatus @default(SOLICITADA)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([vendorId])
  @@map("vendor_order")
}

// ---------------------------------------------------------------------------
// Conteúdo e calendário editorial — Release 1D, parte 1 (seção 17 do manual)
// ---------------------------------------------------------------------------

enum ContentStatus {
  IDEIA
  PAUTA
  PRODUCAO
  REVISAO_INTERNA
  AGUARDANDO_CLIENTE
  AJUSTES
  APROVADO
  AGENDADO
  PUBLICADO
  ARQUIVADO
}

enum ContentChannel {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  OUTRO
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  AJUSTES_SOLICITADOS
}

model ContentItem {
  id            String         @id @default(cuid())
  agencyId      String
  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  channel       ContentChannel
  format        String?
  campaign      String?
  caption       String?
  scheduledDate DateTime?
  status        ContentStatus  @default(IDEIA)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  versions      ContentVersion[]
  statusHistory ContentStatusHistory[]

  @@index([agencyId])
  @@index([clientId])
  @@map("content_item")
}

/// Cada envio de material cria uma versão nova; a aprovação vale só para
/// aquela versão específica (seção 17: "cada upload cria versão; aprovação
/// vale para uma versão específica"). `assetUrl` é um link externo (Drive,
/// Figma, Canva...) — sem upload de arquivo nesta fatia (ver docs/DECISIONS.md).
model ContentVersion {
  id              String      @id @default(cuid())
  contentItemId   String
  contentItem     ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  versionNumber   Int
  assetUrl        String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime    @default(now())

  approval ContentApproval?

  @@unique([contentItemId, versionNumber])
  @@map("content_version")
}

/// Token público de aprovação (mesmo padrão do convite de membro): sem
/// login, expira, e o cliente só vê o que essa versão específica expõe —
/// "links públicos usam token curto, expiração... escopo mínimo" (seção 18).
model ContentApproval {
  id               String         @id @default(cuid())
  contentVersionId String         @unique
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  token            String         @unique
  status           ApprovalStatus @default(PENDENTE)
  decisionNote     String?
  decidedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())

  @@map("content_approval")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model ContentStatusHistory {
  id            String         @id @default(cuid())
  contentItemId String
  contentItem   ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  fromStatus    ContentStatus?
  toStatus      ContentStatus
  reason        String?
  actorUserId   String?
  createdAt     DateTime       @default(now())

  @@index([contentItemId])
  @@map("content_status_history")
}

// ---------------------------------------------------------------------------
// Comunicação e comentários — Release 1D (seção 19 do manual)
// ---------------------------------------------------------------------------

enum CommentThreadStatus {
  ABERTA
  RESOLVIDA
}

enum CommentStatus {
  ATIVO
  EDITADO
  REMOVIDO
}

/// Uma thread por entidade (entityType+entityId) — seção 19: "comentário
/// pertence a uma entidade e workspace". Criada sob demanda no primeiro
/// comentário; entityType é texto livre ("content_item", "request" etc.),
/// não uma FK — a mesma tabela serve qualquer entidade comentável sem
/// precisar de uma coluna nova por módulo.
model CommentThread {
  id               String              @id @default(cuid())
  agencyId         String
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  entityType       String
  entityId         String
  status           CommentThreadStatus @default(ABERTA)
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime            @default(now())

  comments Comment[]

  @@unique([entityType, entityId])
  @@index([agencyId])
  @@map("comment_thread")
}

/// "Mensagem pode virar tarefa apenas por usuário autorizado" (seção 19) —
/// convertedTaskId segue o mesmo padrão de idempotência de
/// Lead.convertedClientId: no máximo uma conversão por comentário.
model Comment {
  id              String        @id @default(cuid())
  threadId        String
  thread          CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId    String
  body            String
  status          CommentStatus @default(ATIVO)
  editedAt        DateTime?
  convertedTaskId String?       @unique
  convertedTask   Task?         @relation(fields: [convertedTaskId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  edits    CommentEdit[]
  mentions CommentMention[]

  @@index([threadId])
  @@map("comment")
}

/// Append-only — "edição mantém histórico; exclusão sensível vira tombstone"
/// (seção 19): cada edição E cada remoção gravam o texto anterior aqui antes
/// de mudar o Comment; remover não apaga a linha, só limpa o body e marca
/// status REMOVIDO, deixando um tombstone visível no lugar.
model CommentEdit {
  id             String   @id @default(cuid())
  commentId      String
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  previousBody   String
  editedByUserId String
  createdAt      DateTime @default(now())

  @@index([commentId])
  @@map("comment_edit")
}

model CommentMention {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  createdAt       DateTime @default(now())

  @@index([commentId])
  @@index([mentionedUserId])
  @@map("comment_mention")
}

// ---------------------------------------------------------------------------
// RH e pessoas — Release 1E, parte 1 (seção 20 do manual)
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ATIVO
  AFASTADO
  DESLIGADO
}

/// Dado de contratação — separado de Membership (acesso/login) de propósito,
/// ver docs/DECISIONS.md ("Convite de equipe mora em Configurações, não em
/// Pessoas"). userId é opcional: nem toda pessoa cadastrada em RH tem conta
/// no sistema (ex.: freelancer sem login).
model Employee {
  id           String         @id @default(cuid())
  agencyId     String
  agency       Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String?
  role         String?
  positionId   String?
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  status       EmployeeStatus @default(ATIVO)
  hiredAt      DateTime?
  terminatedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  leaveRequests          LeaveRequest[]
  statusHistory          EmployeeStatusHistory[]
  enpsInvites            EnpsInvite[]
  convertedFromCandidate Candidate?

  @@index([agencyId])
  @@index([positionId])
  @@map("employee")
}

/// Seção 20 do manual: "cargos" — catálogo simples (título/descrição), sem
/// faixa salarial nem hierarquia — dado de salário é evitado de propósito no
/// projeto inteiro até haver um caso real pedindo (mesma decisão da
/// Release 1E). `role` em Employee continua existindo como texto livre pra
/// quem não tem cargo formal cadastrado ainda — positionId é aditivo, não
/// substitui.
model Position {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime @default(now())

  employees Employee[]
  Job       Job[]

  @@unique([agencyId, title])
  @@index([agencyId])
  @@map("position")
}

enum JobStatus {
  ABERTA
  PAUSADA
  FECHADA
  CANCELADA
}

/// Seção 20: "vaga recebe pipeline configurável" — mesmo padrão de
/// PipelineStage (tabela por vaga, não enum fixo): cada Job tem seu próprio
/// funil de estágios, seguindo a mesma lógica do Pipeline comercial.
model Job {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title       String
  positionId  String?
  position    Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  status      JobStatus @default(ABERTA)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stages     JobStage[]
  candidates Candidate[]

  @@index([agencyId])
  @@map("job")
}

model JobStage {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  candidates Candidate[]

  @@unique([jobId, order])
  @@index([jobId])
  @@map("job_stage")
}

enum CandidateStatus {
  EM_ANDAMENTO
  CONTRATADO
  REJEITADO
  DESISTIU
}

/// "Candidatos ficam em escopo separado e política de retenção" (regra
/// obrigatória, seção 20): sem worker/cron pra decair dado automaticamente
/// (mesma limitação de todo o projeto), a política de retenção nesta fatia é
/// uma ação manual — `anonymizedAt` marca quando alguém da equipe limpou os
/// dados pessoais deste candidato (nome/e-mail/telefone/notas), mantendo a
/// linha só pra estatística do funil.
model Candidate {
  id                  String          @id @default(cuid())
  agencyId            String
  agency              Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  jobId               String
  job                 Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId             String
  stage               JobStage        @relation(fields: [stageId], references: [id])
  name                String
  email               String?
  phone               String?
  notes               String?
  status              CandidateStatus @default(EM_ANDAMENTO)
  rejectedReason      String?
  convertedEmployeeId String?         @unique
  convertedEmployee   Employee?       @relation(fields: [convertedEmployeeId], references: [id], onDelete: SetNull)
  anonymizedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  statusHistory CandidateStatusHistory[]

  @@index([agencyId])
  @@index([jobId])
  @@index([stageId])
  @@map("candidate")
}

/// Append-only — registra tanto mudança de estágio quanto de status na mesma
/// linha, mesmo padrão de OpportunityStatusHistory.
model CandidateStatusHistory {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStageId String?
  toStageId   String?
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime         @default(now())

  @@index([candidateId])
  @@map("candidate_status_history")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model EmployeeStatusHistory {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromStatus  EmployeeStatus?
  toStatus    EmployeeStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime        @default(now())

  @@index([employeeId])
  @@map("employee_status_history")
}

enum LeaveType {
  FERIAS
  AUSENCIA
}

enum LeaveRequestStatus {
  SOLICITADA
  APROVADA
  REJEITADA
  REALIZADA
}

model LeaveRequest {
  id                String             @id @default(cuid())
  agencyId          String
  agency            Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type              LeaveType
  startDate         DateTime
  endDate           DateTime
  status            LeaveRequestStatus @default(SOLICITADA)
  reason            String?
  rejectionReason   String?
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  statusHistory LeaveRequestStatusHistory[]

  @@index([agencyId])
  @@index([employeeId])
  @@map("leave_request")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model LeaveRequestStatusHistory {
  id             String              @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest        @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  fromStatus     LeaveRequestStatus?
  toStatus       LeaveRequestStatus
  reason         String?
  actorUserId    String?
  createdAt      DateTime            @default(now())

  @@index([leaveRequestId])
  @@map("leave_request_status_history")
}

// ---------------------------------------------------------------------------
// Apontamento e produtividade — Release 1E, parte 2 (seção 21 do manual)
// ---------------------------------------------------------------------------

enum TimesheetStatus {
  RASCUNHO
  ENVIADA
  APROVADA
  CORRIGIDA
}

/// Folha semanal — container de TimeEntry por pessoa+semana. Criada sob
/// demanda (mesmo padrão de CommentThread) no primeiro apontamento da semana.
model Timesheet {
  id               String          @id @default(cuid())
  agencyId         String
  agency           Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId           String
  /// Segunda-feira da semana que esta folha cobre.
  weekStart        DateTime
  status           TimesheetStatus @default(RASCUNHO)
  submittedAt      DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  entries       TimeEntry[]
  statusHistory TimesheetStatusHistory[]

  @@unique([userId, weekStart])
  @@index([agencyId])
  @@map("timesheet")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model TimesheetStatusHistory {
  id          String           @id @default(cuid())
  timesheetId String
  timesheet   Timesheet        @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  fromStatus  TimesheetStatus?
  toStatus    TimesheetStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime         @default(now())

  @@index([timesheetId])
  @@map("timesheet_status_history")
}

enum TimeEntrySource {
  MANUAL
  TIMER
}

model TimeEntry {
  id          String          @id @default(cuid())
  agencyId    String
  agency      Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId      String
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timesheetId String
  timesheet   Timesheet       @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime
  minutes     Int
  description String?
  source      TimeEntrySource @default(MANUAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  edits TimeEntryEdit[]

  @@index([agencyId])
  @@index([userId])
  @@index([taskId])
  @@index([timesheetId])
  @@map("time_entry")
}

/// Append-only — "correção posterior guarda autor e motivo" (seção 21).
model TimeEntryEdit {
  id              String    @id @default(cuid())
  timeEntryId     String
  timeEntry       TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  previousMinutes Int
  reason          String?
  editedByUserId  String
  createdAt       DateTime  @default(now())

  @@index([timeEntryId])
  @@map("time_entry_edit")
}

// ---------------------------------------------------------------------------
// Financeiro básico manual — Release 1E, parte 3 (seção 22 do manual)
// ---------------------------------------------------------------------------

enum FinanceEntryType {
  RECEITA
  DESPESA
}

/// Seção 26.1: "categorias suportam hierarquia e natureza: receita, custo
/// direto, despesa operacional, imposto, investimento e transferência." É a
/// natureza (não o `FinanceEntryType`) que decide em qual linha do DRE
/// (seção 26.2) um lançamento entra — ex.: um imposto é tecnicamente uma
/// DESPESA, mas por natureza reduz a receita bruta, não é "despesa
/// operacional".
enum FinanceCategoryNature {
  RECEITA
  IMPOSTO_DEDUCAO
  CUSTO_DIRETO
  DESPESA_OPERACIONAL
  DESPESA_FINANCEIRA
  INVESTIMENTO
  TRANSFERENCIA
}

/// Seção 22: "previsto -> pendente -> pago/recebido -> vencido -> cancelado".
/// LIQUIDADO cobre tanto "pago" (DESPESA) quanto "recebido" (RECEITA) — o
/// rótulo na UI muda conforme FinanceEntryType, mesmo padrão já usado em
/// WorkItemStatus (compartilhado por Project e Task).
enum FinanceEntryStatus {
  PREVISTO
  PENDENTE
  LIQUIDADO
  VENCIDO
  CANCELADO
}

model FinanceCategory {
  id        String                @id @default(cuid())
  agencyId  String
  agency    Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  type      FinanceEntryType
  nature    FinanceCategoryNature @default(DESPESA_OPERACIONAL)
  createdAt DateTime              @default(now())

  entries FinanceEntry[]

  @@unique([agencyId, name, type])
  @@index([agencyId])
  @@map("finance_category")
}

/// "Movimento pode estar ligado a cliente, contrato, projeto e categoria"
/// (seção 22) — contrato não existe como entidade própria neste projeto
/// (decisão: contratos ficam no Drive, ver docs/DECISIONS.md), então o
/// vínculo aqui é só client/project/category.
model FinanceEntry {
  id               String             @id @default(cuid())
  agencyId         String
  agency           Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type             FinanceEntryType
  status           FinanceEntryStatus @default(PREVISTO)
  description      String
  /// Valor em centavos — nunca float. Negativo só em estornos (ver reversalOfId).
  amountCents      Int
  categoryId       String?
  category         FinanceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// "Separar competência, vencimento e liquidação" (seção 22) — três datas
  /// com significado diferente, nunca uma só reaproveitada pras três coisas.
  competencyDate   DateTime
  dueDate          DateTime
  settledDate      DateTime?
  /// Se preenchido, esta linha É o estorno de outra (amountCents negativo,
  /// cancela o original nas somas de fluxo de caixa). "Valores são imutáveis
  /// após conciliação; correção por estorno/ajuste" (seção 22) — a linha
  /// original nunca é editada depois de LIQUIDADO, só contra-lançada.
  reversalOfId     String?            @unique
  reversalOf       FinanceEntry?      @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy       FinanceEntry?      @relation("EntryReversal")
  /// Seção 28 (régua de cobrança): tarefa de acompanhamento criada quando o
  /// lançamento entra em atraso (D+1 ou depois). Nulo até alguém clicar em
  /// "Criar tarefa de cobrança" — nunca automático (sem apps/worker ainda).
  collectionTaskId String?            @unique
  collectionTask   Task?              @relation(fields: [collectionTaskId], references: [id], onDelete: SetNull)
  /// Boleto/fatura em PDF anexado pelo time (pedido do usuário, 2026-09-07) —
  /// reaproveita `MediaAsset`/R2, mesmo storage já usado por Arquivos/Biblioteca.
  /// `onDelete: SetNull`: apagar o arquivo nunca apaga o lançamento financeiro.
  boletoAssetId    String?            @unique
  boletoAsset      MediaAsset?        @relation(fields: [boletoAssetId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  statusHistory FinanceEntryStatusHistory[]

  @@index([agencyId])
  @@index([clientId])
  @@index([projectId])
  @@map("finance_entry")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model FinanceEntryStatusHistory {
  id             String              @id @default(cuid())
  financeEntryId String
  financeEntry   FinanceEntry        @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  fromStatus     FinanceEntryStatus?
  toStatus       FinanceEntryStatus
  reason         String?
  actorUserId    String?
  createdAt      DateTime            @default(now())

  @@index([financeEntryId])
  @@map("finance_entry_status_history")
}

// ---------------------------------------------------------------------------
// Arquivos e biblioteca de mídia — seções 9.3 e 17 do manual
// ---------------------------------------------------------------------------

/// Um arquivo enviado (Cloudflare R2) — serve tanto "Arquivos do cliente"
/// (seção 9.3) quanto "Biblioteca" de conteúdo (seção 17): mesma necessidade
/// (guardar um arquivo com metadado e servir com segurança), sem duplicar
/// tabela. `clientId` opcional distingue arquivo de cliente de material
/// interno/genérico.
model MediaAsset {
  id               String   @id @default(cuid())
  agencyId         String
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Chave do objeto no bucket R2 — nunca a URL final (que expira, ver lib/r2.ts).
  key              String   @unique
  fileName         String
  contentType      String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  boletoFor FinanceEntry?

  @@index([agencyId])
  @@index([clientId])
  @@map("media_asset")
}

// ---------------------------------------------------------------------------
// Health Score — Fase 2, parte 1 (seção 30 do manual)
// ---------------------------------------------------------------------------

/// Foto do cálculo do Health Score num momento — nunca sobrescrita, sempre uma
/// linha nova (seção 30.2: "guardar score total, dimensões, sinais, pesos,
/// versão do modelo, data e explicação" — histórico é o próprio requisito).
/// `breakdown` é JSON em vez de tabela normalizada (`health_factors` do
/// manual): nesta fatia ninguém precisa consultar fatores individuais entre
/// clientes, só exibir o "porquê" de um score específico — ver DATA_MODEL.md.
model HealthScoreSnapshot {
  id               String   @id @default(cuid())
  agencyId         String
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  score            Int
  modelVersion     String
  breakdown        Json
  computedByUserId String?
  createdAt        DateTime @default(now())

  @@index([agencyId])
  @@index([clientId])
  @@map("health_score_snapshot")
}

// ---------------------------------------------------------------------------
// Risco de churn — Fase 2, parte 2 (seção 31 do manual)
// ---------------------------------------------------------------------------

enum ChurnRiskBand {
  BAIXO
  MEDIO
  ALTO
}

/// Foto do cálculo de risco de churn — mesmo padrão append-only do
/// HealthScoreSnapshot. Diferente do Health Score (média ponderada), o manual
/// descreve um modelo aditivo de sinais explicáveis (seção 31: "regras
/// explicáveis; modelo estatístico/ML só depois de volume suficiente") — cada
/// sinal disparado soma pontos fixos, sem normalização.
model ChurnRiskSnapshot {
  id               String        @id @default(cuid())
  agencyId         String
  agency           Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  score            Int
  band             ChurnRiskBand
  modelVersion     String
  signals          Json
  computedByUserId String?
  createdAt        DateTime      @default(now())

  @@index([agencyId])
  @@index([clientId])
  @@map("churn_risk_snapshot")
}

enum RetentionPlanStatus {
  ATIVO
  CONCLUIDO
  CANCELADO
}

/// Playbook de retenção (seção 31.1): "toda recomendação precisa de
/// responsável, prazo, próxima revisão e resultado". `responsibleUserId` e
/// `createdByUserId` são Strings simples sem relation formal ao User — mesmo
/// padrão já usado em `Task.assigneeUserId`.
model RetentionPlan {
  id                String              @id @default(cuid())
  agencyId          String
  agency            Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  alertReason       String
  diagnosis         String
  responsibleUserId String
  planDescription   String
  meetingDate       DateTime?
  reassessDate      DateTime?
  status            RetentionPlanStatus @default(ATIVO)
  result            String?
  createdByUserId   String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  statusHistory RetentionPlanStatusHistory[]

  @@index([agencyId])
  @@index([clientId])
  @@map("retention_plan")
}

/// Append-only — reavaliação/conclusão do plano nunca apaga o histórico.
model RetentionPlanStatusHistory {
  id          String               @id @default(cuid())
  planId      String
  plan        RetentionPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromStatus  RetentionPlanStatus?
  toStatus    RetentionPlanStatus
  note        String?
  actorUserId String?
  createdAt   DateTime             @default(now())

  @@index([planId])
  @@map("retention_plan_status_history")
}

// ---------------------------------------------------------------------------
// NPS — Fase 2, parte 4 (seção 32.1 do manual)
// ---------------------------------------------------------------------------

enum SurveyStatus {
  RASCUNHO
  ENVIADA
  ENCERRADA
}

enum SurveyRecipientStatus {
  PENDENTE
  ENVIADO
  RESPONDIDO
}

/// Seção 32.1: "pesquisas possuem campanha, pergunta 0-10, comentário,
/// público, janela, anonimato e consentimento." eNPS (funcionários) é
/// deliberadamente fora de escopo desta fatia — o próprio manual pede acesso
/// restrito e cuidado de anonimato diferente do NPS de cliente, então tratar
/// os dois com o mesmo modelo seria misturar dois níveis de sensibilidade.
model SurveyCampaign {
  id              String       @id @default(cuid())
  agencyId        String
  agency          Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  /// Pergunta 0-10 customizável — vem com um texto padrão sugerido, mas a
  /// agência pode reescrever livremente (seção 32: "pode ser personalizada").
  question        String
  commentPrompt   String?
  headerText      String?
  footerText      String?
  status          SurveyStatus @default(RASCUNHO)
  sentAt          DateTime?
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  recipients   SurveyRecipient[]
  npsSnapshots NpsSnapshot[]

  @@index([agencyId])
  @@map("survey_campaign")
}

/// Um lançamento por cliente por campanha (`@@unique`) — "público" da seção
/// 32.1. Resposta é gravada na própria linha (score/comment/respondedAt) em
/// vez de uma tabela `survey_responses` separada porque, para NPS de
/// cliente, é sempre 1 destinatário = no máximo 1 resposta; não há o cenário
/// de "várias respostas por convite" que justificaria separar as tabelas.
model SurveyRecipient {
  id          String                @id @default(cuid())
  campaignId  String
  campaign    SurveyCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactName String
  email       String
  token       String                @unique
  status      SurveyRecipientStatus @default(PENDENTE)
  sentAt      DateTime?
  score       Int?
  comment     String?
  respondedAt DateTime?
  createdAt   DateTime              @default(now())

  @@unique([campaignId, clientId])
  @@index([campaignId])
  @@index([clientId])
  @@map("survey_recipient")
}

/// Append-only, mesmo padrão de HealthScoreSnapshot/ChurnRiskSnapshot — cada
/// recálculo grava uma linha nova. "NPS = % promotores - % detratores"
/// (seção 32.1), sempre relativo a uma campanha específica.
model NpsSnapshot {
  id             String         @id @default(cuid())
  agencyId       String
  agency         Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  score          Int
  promoters      Int
  passives       Int
  detractors     Int
  totalResponses Int
  computedAt     DateTime       @default(now())

  @@index([agencyId])
  @@index([campaignId])
  @@map("nps_snapshot")
}

// ---------------------------------------------------------------------------
// eNPS — Fase 2, parte 5 (seção 32.1 do manual)
// ---------------------------------------------------------------------------

enum EnpsCampaignStatus {
  RASCUNHO
  ENVIADA
  ENCERRADA
}

enum EnpsInviteStatus {
  PENDENTE
  ENVIADO
  RESPONDIDO
}

/// Seção 32.1: "eNPS é separado e acesso é restrito; resultado de equipe não
/// pode expor respondente quando anonimato for prometido." Acesso restrito
/// implementado em `lib/rbac.ts` (`canViewEnps`). Anonimato implementado no
/// próprio desenho do schema — ver EnpsResponse abaixo — não é só uma regra
/// de UI.
model EnpsCampaign {
  id              String             @id @default(cuid())
  agencyId        String
  agency          Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  question        String
  commentPrompt   String?
  headerText      String?
  footerText      String?
  status          EnpsCampaignStatus @default(RASCUNHO)
  sentAt          DateTime?
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  invites   EnpsInvite[]
  responses EnpsResponse[]
  snapshots EnpsSnapshot[]

  @@index([agencyId])
  @@map("enps_campaign")
}

/// Controla só PARTICIPAÇÃO (quem foi convidado, se já respondeu) — nunca a
/// nota. Existe pra evitar convite duplicado e mostrar taxa de resposta sem
/// nunca ligar uma pessoa a uma nota específica.
model EnpsInvite {
  id          String           @id @default(cuid())
  campaignId  String
  campaign    EnpsCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  email       String
  token       String           @unique
  status      EnpsInviteStatus @default(PENDENTE)
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([campaignId, employeeId])
  @@index([campaignId])
  @@map("enps_invite")
}

/// Anônima por desenho: SEM employeeId, SEM referência ao EnpsInvite que
/// originou a resposta. Uma linha aqui só prova "alguém convidado
/// respondeu", nunca quem — mesmo para quem tem acesso direto ao banco.
/// Limite honesto documentado em docs/DECISIONS.md: correlação por horário
/// de resposta ainda é tecnicamente possível numa campanha com pouquíssimos
/// respondentes, como em qualquer pesquisa "anônima" real.
model EnpsResponse {
  id         String       @id @default(cuid())
  campaignId String
  campaign   EnpsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  score      Int
  comment    String?
  createdAt  DateTime     @default(now())

  @@index([campaignId])
  @@map("enps_response")
}

/// Append-only, mesmo padrão de NpsSnapshot — eNPS = % promotores - % detratores entre os funcionários.
model EnpsSnapshot {
  id             String       @id @default(cuid())
  agencyId       String
  agency         Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       EnpsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  score          Int
  promoters      Int
  passives       Int
  detractors     Int
  totalResponses Int
  computedAt     DateTime     @default(now())

  @@index([agencyId])
  @@index([campaignId])
  @@map("enps_snapshot")
}

// ---------------------------------------------------------------------------
// Leads e CRM — Fase 3, parte 1 (seção 39 do manual)
// ---------------------------------------------------------------------------

enum LeadStatus {
  NOVO
  EM_ANDAMENTO
  QUALIFICADO
  DESQUALIFICADO
  CONVERTIDO
}

/// Seção 39: "Lead 360 reúne origem, campos, tags, consentimentos, score,
/// timeline, oportunidades e comunicações." Nesta primeira fatia: origem,
/// campos básicos e timeline (histórico + notas) — tags, score e
/// oportunidades ficam para fatias seguintes (Pipeline ainda não existe).
model Lead {
  id                 String     @id @default(cuid())
  agencyId           String
  agency             Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  /// Seção 39.1: "e-mail normalizado é chave primária operacional" — sempre
  /// salvo em minúsculas; `@@unique([agencyId, email])` abaixo é a garantia
  /// real de duplicidade (Postgres permite múltiplos NULL, então lead sem
  /// e-mail nunca colide).
  email              String?
  phone              String?
  company            String?
  source             String?
  status             LeadStatus @default(NOVO)
  disqualifiedReason String?
  ownerUserId        String?
  convertedClientId  String?    @unique
  convertedClient    Client?    @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)
  createdByUserId    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  statusHistory    LeadStatusHistory[]
  notes            LeadNote[]
  opportunities    Opportunity[]
  proposals        Proposal[]
  trackingVisitors TrackingVisitor[]

  @@unique([agencyId, email])
  @@index([agencyId])
  @@map("lead")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model LeadStatusHistory {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime    @default(now())

  @@index([leadId])
  @@map("lead_status_history")
}

model LeadNote {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body         String
  authorUserId String?
  createdAt    DateTime @default(now())

  @@index([leadId])
  @@map("lead_note")
}

// ---------------------------------------------------------------------------
// Pipeline comercial — Fase 3, parte 2 (seção 39 do manual)
// ---------------------------------------------------------------------------

/// "Custom pipeline" (seção 39) — colunas do funil configuráveis por
/// agência, semeadas com um padrão de 4 no signup (mesmo padrão do
/// OnboardingTemplate). Só existem estágios "abertos"; Ganho/Perdido é
/// `Opportunity.status`, não uma coluna do board.
model PipelineStage {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@unique([agencyId, order])
  @@index([agencyId])
  @@map("pipeline_stage")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

/// Seção 39: "Opportunity: custom pipeline; open -> won/lost." Vinculada a
/// um Lead e/ou Client (uma oportunidade pode nascer de um lead convertido,
/// ou direto de um cliente já ativo pedindo um novo serviço).
model Opportunity {
  id                String            @id @default(cuid())
  agencyId          String
  agency            Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name              String
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  valueCents        Int?
  stageId           String
  stage             PipelineStage     @relation(fields: [stageId], references: [id])
  status            OpportunityStatus @default(OPEN)
  lostReason        String?
  expectedCloseDate DateTime?
  ownerUserId       String?
  createdByUserId   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statusHistory OpportunityStatusHistory[]
  proposals     Proposal[]

  @@index([agencyId])
  @@index([clientId])
  @@index([leadId])
  @@index([stageId])
  @@map("opportunity")
}

/// Append-only, mesmo padrão das demais *StatusHistory — registra tanto
/// movimentação de estágio (status continua OPEN, `toStageId` muda) quanto
/// mudança de status (Ganho/Perdido, `toStageId` nulo).
model OpportunityStatusHistory {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStageId   String?
  toStageId     String?
  toStatus      OpportunityStatus
  reason        String?
  actorUserId   String?
  createdAt     DateTime          @default(now())

  @@index([opportunityId])
  @@map("opportunity_status_history")
}

// ---------------------------------------------------------------------------
// Propostas — Fase 3, parte 3 (seção 39 do manual), fecha a seção
// ---------------------------------------------------------------------------

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  VISUALIZADA
  ACEITA
  REJEITADA
  EXPIRADA
}

/// Seção 39: "Proposal: draft -> sent -> viewed -> accepted/rejected/expired."
/// Link público de visualização/decisão, mesmo padrão já usado em
/// ContentApproval (/aprovar/[token]) e SurveyRecipient (/pesquisa/[token]) —
/// TTL de 14 dias idêntico ao de ContentApproval.
model Proposal {
  id              String         @id @default(cuid())
  agencyId        String
  agency          Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  content         String
  valueCents      Int?
  status          ProposalStatus @default(RASCUNHO)
  token           String         @unique
  sentAt          DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime?
  rejectedReason  String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  statusHistory ProposalStatusHistory[]

  @@index([agencyId])
  @@index([clientId])
  @@index([leadId])
  @@index([opportunityId])
  @@map("proposal")
}

/// Append-only, mesmo padrão das demais *StatusHistory.
model ProposalStatusHistory {
  id          String          @id @default(cuid())
  proposalId  String
  proposal    Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fromStatus  ProposalStatus?
  toStatus    ProposalStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime        @default(now())

  @@index([proposalId])
  @@map("proposal_status_history")
}

// ---------------------------------------------------------------------------
// Tracking — Fase 3, seção 34 do manual (abre a Fase 3: "Atrair, medir e
// otimizar"). Rastreia visitantes do site/landing pages da própria agência
// (não de clientes dela) para alimentar o CRM (seção 39, já existente) — um
// visitante identificado por e-mail vira/enriquece um `Lead`.
// ---------------------------------------------------------------------------

/// `visitor_id` anônimo (seção 34.2) — nasce na primeira chamada ao coletor
/// (o servidor gera e devolve; o snippet do site persiste localmente).
/// `leadId` é a única forma de "identidade resolvida" desta fatia: sem tabela
/// de merge/confiança/evidência (seção 34.2 completa) — se um e-mail normalizado
/// já é um Lead existente, o visitante vincula a ele; senão, cria um Lead novo.
model TrackingVisitor {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  sessions TrackingSession[]
  events   TrackingEvent[]
  consents TrackingConsent[]

  @@index([agencyId])
  @@index([leadId])
  @@map("tracking_visitor")
}

/// `session_id` expira depois de 30min sem evento novo (janela fixa nesta
/// fatia — o manual pede "rotação e expiração configuradas", configuração
/// fica para quando houver caso real pedindo). Atribuição UTM é sempre a do
/// evento que abriu a sessão (first-touch da sessão, não da jornada inteira —
/// isso é o problema de `Attribution`, seção 36, ainda não construído).
model TrackingSession {
  id          String          @id @default(cuid())
  visitorId   String
  visitor     TrackingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt   DateTime        @default(now())
  lastEventAt DateTime        @updatedAt
  landingUrl  String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  events TrackingEvent[]

  @@index([visitorId])
  @@map("tracking_session")
}

/// Append-only por natureza (nenhuma rota edita/apaga um evento já recebido).
/// `@@unique([agencyId, eventId])` é a garantia real de deduplicação do banco
/// (seção 34: "event_id gerado uma vez e reutilizado em browser/server") —
/// reenviar o mesmo `eventId` (ex.: retry de rede) nunca duplica a linha.
/// `consent` é um snapshot JSON do consentimento vigente no momento exato do
/// evento (seção 34: "categorias e versão do consentimento no momento do
/// evento") — nunca lido de `TrackingConsent` depois, porque consentimento
/// muda com o tempo e o evento precisa continuar auditável como aconteceu.
model TrackingEvent {
  id          String           @id @default(cuid())
  agencyId    String
  agency      Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  visitorId   String
  visitor     TrackingVisitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     TrackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  eventName   String
  eventId     String
  url         String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  properties  Json?
  consent     Json
  occurredAt  DateTime
  receivedAt  DateTime         @default(now())

  @@unique([agencyId, eventId])
  @@index([agencyId, occurredAt])
  @@index([visitorId])
  @@map("tracking_event")
}

enum TrackingConsentCategory {
  ESSENCIAL
  ANALYTICS
  MARKETING
  PERSONALIZACAO
}

/// Append-only (seção 35: consentimento precisa de prova auditável, nunca
/// sobrescrita) — cada decisão nova do visitante (aceitar/mudar categorias)
/// cria uma linha; "consentimento atual" é sempre a mais recente por
/// `visitorId`. `categories` é a lista do que foi concedido nessa decisão
/// (ESSENCIAL está sempre implícito/permitido, mas é gravado explicitamente
/// pra o registro ficar completo por si só, sem depender de uma regra externa
/// pra interpretar "ausência = permitido").
model TrackingConsent {
  id            String                    @id @default(cuid())
  agencyId      String
  agency        Agency                    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  visitorId     String
  visitor       TrackingVisitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  categories    TrackingConsentCategory[]
  noticeVersion String
  createdAt     DateTime                  @default(now())

  @@index([visitorId])
  @@map("tracking_consent")
}

// ---------------------------------------------------------------------------
// Campanhas, UTMs e atribuição — Fase 3, seção 36 do manual. Sem tabela de
// "touchpoint" nem de "modelo de atribuição": um touchpoint é derivado de
// `TrackingSession` (que já guarda os UTMs) casado com uma `Campaign` por
// utm_source+utm_campaign; os modelos (first touch/last non-direct/linear)
// são funções puras em `apps/web/lib/attribution.ts`, nunca persistidos —
// mesmo raciocínio já usado em Cohort/DRE/Indicadores financeiros ("não
// modelar o que dá pra derivar"). Ver docs/DECISIONS.md de 2026-09-07.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  ATIVA
  PAUSADA
  ENCERRADA
}

/// Ad set/anúncio (granularidade abaixo de campanha, seção 36) ficam de fora
/// desta fatia — sem um conector real (seção 38) pra sincronizar automaticamente
/// aquele nível, pedir pra alguém digitar isso à mão não tem caso de uso real
/// ainda. `channel`/`utmSource`/`utmCampaign` são texto livre, mesmo padrão de
/// `Lead.source` — fechar num enum exigiria prever cada plataforma de anúncio
/// de antemão.
/// `clientId` (pedido do usuário, 2026-09-07) distingue duas naturezas que
/// usam o mesmo desenho: nulo é campanha do funil comercial da própria
/// agência (seção 34/39, atribuída a Lead/Opportunity); preenchido é tráfego
/// pago que a agência gerencia PRA aquele cliente, mostrado a ele em
/// `/portal/trafego` — as duas nunca se misturam na tela errada.
model Campaign {
  id          String         @id @default(cuid())
  agencyId    String
  agency      Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  channel     String
  objective   String?
  startDate   DateTime?
  endDate     DateTime?
  budgetCents Int?
  currency    String         @default("BRL")
  ownerUserId String?
  externalId  String?
  utmSource   String?
  utmCampaign String?
  status      CampaignStatus @default(ATIVA)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  dailyMetrics CampaignDailyMetric[]

  @@index([agencyId])
  @@index([clientId])
  @@map("campaign")
}

/// "Métricas diárias" (seção 36) — uma linha por dia por campanha, sempre a
/// visão "reportada pela plataforma de anúncios" (ou digitada à mão nesta
/// fatia, sem conector). Nunca confundir com "Atribuição Zenith" (calculada
/// à parte, sobre dado próprio de tracking+CRM) — a seção 36 é explícita
/// que as duas podem divergir e precisam de rótulo claro, nunca fingir
/// equivalência.
model CampaignDailyMetric {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  spendCents  Int      @default(0)
  impressions Int      @default(0)
  reach       Int?
  clicks      Int      @default(0)
  results     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([campaignId])
  @@map("campaign_daily_metric")
}

// ---------------------------------------------------------------------------
// Motor de automações — Fase 3, seção 40 do manual. Grafo simplificado pra
// uma lista sequencial de passos (sem canvas visual, sem ramificação — uma
// `CONDICAO` que falha só encerra a execução) e gatilhos ligados a mutações
// que já existem no produto (não a um outbox_events formal, que não existe).
// Ver docs/DECISIONS.md de 2026-09-07 pros recortes de escopo.
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  RASCUNHO
  ATIVO
  PAUSADO
  ARQUIVADO
}

enum WorkflowRunStatus {
  EXECUTANDO
  AGUARDANDO
  CONCLUIDO
  FALHOU
}

enum WorkflowStepType {
  CONDICAO
  ESPERA
  ACAO
}

/// `triggerEvent` é texto fechado em código (`TRIGGER_EVENTS` em
/// `apps/web/lib/workflows.ts`), mesmo padrão de `CommentEntityType`.
/// `draftSteps` só é lido/escrito enquanto `status = RASCUNHO` — depois de
/// publicado, o rascunho não tem mais efeito (a versão publicada é a fonte
/// de verdade); esta fatia não suporta editar/republicar um workflow já ativo.
model Workflow {
  id              String         @id @default(cuid())
  agencyId        String
  agency          Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  triggerEvent    String
  status          WorkflowStatus @default(RASCUNHO)
  draftSteps      Json           @default("[]")
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  versions WorkflowVersion[]

  @@index([agencyId])
  @@index([agencyId, triggerEvent, status])
  @@map("workflow")
}

/// "Publicar cria versão imutável" (seção 40) — `steps` nunca muda depois de
/// criada. `@@unique([workflowId, version])` garante a numeração sequencial
/// sem colisão.
model WorkflowVersion {
  id                String   @id @default(cuid())
  workflowId        String
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version           Int
  steps             Json
  publishedAt       DateTime @default(now())
  publishedByUserId String?

  runs WorkflowRun[]

  @@unique([workflowId, version])
  @@map("workflow_version")
}

/// `subjectType`/`subjectId` identificam o registro que disparou o gatilho
/// (ex.: "lead"/id) — só pra navegação na UI, a execução em si só lê
/// `payload` (snapshot no momento do gatilho, nunca relido do banco depois).
/// `resumeAt` é o mecanismo real de `ESPERA`: sem worker/cron, uma automação
/// pendente só avança quando alguém aciona "Processar automações pendentes"
/// (mesmo padrão manual de Rotinas/Recorrências) e `resumeAt <= now()`.
model WorkflowRun {
  id                String            @id @default(cuid())
  workflowVersionId String
  workflowVersion   WorkflowVersion   @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  subjectType       String
  subjectId         String
  payload           Json
  status            WorkflowRunStatus @default(EXECUTANDO)
  currentStepIndex  Int               @default(0)
  resumeAt          DateTime?
  startedAt         DateTime          @default(now())
  finishedAt        DateTime?

  stepRuns WorkflowStepRun[]

  @@index([workflowVersionId])
  @@index([status, resumeAt])
  @@map("workflow_run")
}

/// Um `WorkflowStepRun` por passo executado — log append-only (seção 40:
/// "requisitos: ...logs"). `error` preenchido marca falha; a run inteira para
/// ali (sem retry/backoff real, que dependeria da fila que não existe).
model WorkflowStepRun {
  id            String           @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun      @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  stepIndex     Int
  stepType      WorkflowStepType
  input         Json?
  output        Json?
  error         String?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?

  @@index([workflowRunId])
  @@map("workflow_step_run")
}

/// Colunas customizáveis dentro do balde "Fazendo" do Kanban de Operação
/// (pedido do usuário, 2026-09-07 — ver docs/DECISIONS.md). Mesmo padrão de
/// `PipelineStage`: posicional/renomeável, nunca a fonte da verdade sobre se
/// a tarefa está concluída — isso continua sendo só `Task.status`
/// (`WorkItemStatus`), do qual Health Score e Risco de churn dependem.
/// `stageId` em `Task` é nulo em BACKLOG/CONCLUIDA/CANCELADA; só tarefas
/// `EM_ANDAMENTO` moram numa `OperationStage`.
model OperationStage {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  tasks Task[]

  @@unique([agencyId, order])
  @@index([agencyId])
  @@map("operation_stage")
}
